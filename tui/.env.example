# Copie ce fichier en `.env` (jamais commité, voir ../.gitignore) et
# renseigne les vraies valeurs — mêmes conventions que worker/.env et
# aggregator/.env.

# IP Tailscale du VPS (`tailscale ip -4` sur le VPS), port de l'aggregator.
AGGREGATOR_URL=http://100.x.y.z:8321

# Même secret que AGGREGATOR_API_TOKEN côté aggregator/worker — l'API ne
# distingue pas les appelants (voir aggregator/src/malt_radar_aggregator/auth.py).
AGGREGATOR_API_TOKEN=secure_api_token
