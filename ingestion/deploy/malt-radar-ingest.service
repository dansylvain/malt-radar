[Unit]
Description=Malt-Radar daily ingestion (Free-Work + France Travail)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/projects/malt-radar/ingestion
EnvironmentFile=/root/projects/malt-radar/ingestion/.env
ExecStart=/root/projects/malt-radar/ingestion/.venv/bin/python -m malt_radar_ingestion.ingest free_work --max-pages 5
ExecStart=/root/projects/malt-radar/ingestion/.venv/bin/python -m malt_radar_ingestion.ingest france_travail --max-pages 3
