[Unit]
Description=Daily trigger for malt-radar-worker.service

[Timer]
# Offset from ingestion's timer (06:00 UTC + up to 30min jitter) so the
# worker's pull always finds that day's freshly-ingested missions already
# committed to malt_radar.db on the VPS.
OnCalendar=*-*-* 07:00:00 UTC
RandomizedDelaySec=1800
Persistent=true

[Install]
WantedBy=timers.target
