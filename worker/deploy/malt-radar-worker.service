[Unit]
Description=Malt-Radar worker: pull missions, extract entities via Ollama, push fiches
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=oneshot
User=CHANGE_ME
WorkingDirectory=CHANGE_ME_ABSOLUTE_PATH/worker
EnvironmentFile=CHANGE_ME_ABSOLUTE_PATH/worker/.env
ExecStart=CHANGE_ME_ABSOLUTE_PATH/worker/.venv/bin/python -m malt_radar_worker.run --limit 20
