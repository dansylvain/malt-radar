[Unit]
Description=Malt-Radar worker: pull missions, extract entities via Ollama, push fiches
Wants=network-online.target ollama.service
After=network-online.target ollama.service

[Service]
Type=oneshot
User=dan
WorkingDirectory=/home/dan/malt-radar/worker
EnvironmentFile=/home/dan/malt-radar/worker/.env
ExecStart=/home/dan/malt-radar/worker/.venv/bin/python -m malt_radar_worker.run --limit 20
